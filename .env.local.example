# MongoDB Connection (Local or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/anchordrop
# Atlas connection example:
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/anchordrop?retryWrites=true&w=majority

# Session / JWT Authentication Secret
AUTH_SECRET=anchor-drop-super-secure-dev-secret-key-replace-in-production

# Application Base URL
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
