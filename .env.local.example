# ==============================================================================
# ⚓ ANCHORDROP CONFIGURATION & FEATURE TOGGLES
# ==============================================================================

# Database Connection (Local MongoDB or MongoDB Atlas Cloud URL)
# Example for Atlas: mongodb+srv://<user>:<password>@cluster0.abcde.mongodb.net/anchordrop?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/anchordrop

# Session / JWT Authentication Secret
AUTH_SECRET=anchor-drop-super-secure-dev-secret-key-replace-in-production

# Application Base URL
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Feature Flags (true / false toggles)
# ------------------------------------------------------------------------------

# 1. Interactive Maps (100% Free OpenStreetMap & OpenSeaMap nautical chart tiles - No API keys needed!)
NEXT_PUBLIC_ENABLE_MAPS=true

# 2. Payment Method: "dockside" (Cash on Arrival / Pay at Berth) vs "stripe"
NEXT_PUBLIC_PAYMENT_MODE=dockside

# 3. External Notifications: Set true when external SMS (Twilio) or Email (Resend) are configured
ENABLE_EXTERNAL_NOTIFICATIONS=false
